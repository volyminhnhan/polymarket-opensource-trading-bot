# ================================================================
# KoNiS Polymarket Trading Bot v3 — Configuration
# Copy to .env and fill in your values
#
# V3 Strategy: DCA, rebalance, volatility farming on 15-minute markets
# Dual-side maintenance with automatic position management
# ================================================================

# --- Mode & Markets ---
SCALPING_DRY_RUN=true
DRY_RUN=true
SCALPING_SIMULATED_BALANCE=500
REDIS_ENABLED=true
V3_WINDOW_MINUTES=15
V3_ENABLED_MARKETS=btc

# --- Prediction API (Optional — from konis.ai) ---
V5_PREDICTION_API_URL=
V7_PREDICTION_API_URL=
PREDICTION_USERNAME=
PREDICTION_PASSWORD=

# --- Volatility Filter ---
V3_VOLATILITY_ENABLED=false
V3_VOLATILITY_THRESHOLD=btc:0.06,eth:0.1,xrp:0.1,sol:0.1

# --- Capital / Exposure Limits ---
BOT_STOP_THRESHOLD=50
SCALPING_PARALLEL_MARKETS=true
SCALPING_MAX_CAPITAL_PER_MARKET_PCT=1.0
SCALPING_MAX_TOTAL_EXPOSURE_PCT=0.80

# --- Core Entry ---
V3_ENTRY_AMOUNT_USD=50
V3_ENTRY_LEADER_MULT=2.0
V3_ENTRY_TRAILER_MULT=0.75
V3_ENTRY_PREDICTION_SOURCE=api
V3_ENTRY_MIN_CONFIDENCE=0.85
V3_ENTRY_MIN_QUALITY=0.20
V3_ENTRY_MIN_MOMENTUM=0.07

# --- DCA ---
V3_DCA_AMOUNT_USD=25
V3_MAX_POSITION_COST_USD=200
V3_MAX_DCA_WIN_PER_WINDOW=2
V3_DCA_MODE=rebalance
V3_DCA_DELAY_MINUTES=0.5
V3_DCA_CUTOFF_MINUTES=3
V3_DCA_COOLDOWN_SEC=3

# --- Order Sizing ---
SCALPING_MAX_POSITION_TOKENS=1000
SCALPING_DCA_CHUNK_TOKENS=50
SCALPING_DYNAMIC_CHUNKS=true
SCALPING_CHUNK_MIN_TOKENS=30
SCALPING_CHUNK_MAX_TOKENS=150
SCALPING_CHUNK_LIQUIDITY_PCT=0.50

# --- Trading Bands ---
V3_BUY_BAND_LOW=0.05
V3_BUY_BAND_HIGH=0.58
V3_DCA_WINNER_MIN_PRICE=0.55
V3_DCA_LOSER_MAX_PRICE=0.24
V3_RESOLVE_TARGET_PRICE=0.95
V3_RESOLVE_SKIP_SELL_PRICE=0.99

# --- Signal Quality / Regime ---
V3_PREDICTION_BOOST_MIN_CONFIDENCE=0.85
V3_DCA_MIN_QUALITY_SCORE=0.20
V3_REGIME_TREND_CONFIDENCE=0.91
V3_REGIME_TREND_MOMENTUM=0.12
V3_REGIME_CHOP_TP=0.05

# --- Timing / Execution ---
V3_ENTRY_CUTOFF_MINUTES=0
V3_GHOST_FILL_COOLDOWN_SEC=10
SCALPING_CHECK_INTERVAL=1
SCALPING_PENDING_ORDER_TIMEOUT=10
SCALPING_MARKET_ACTION_COOLDOWN_SEC=5.0
MAX_RETRY=5
V3_TAKER_FEE_PCT=0.02

# --- Combined TP ---
SCALPING_COMBINED_TP_ENABLED=true
SCALPING_COMBINED_TP_PCT=0.165
SCALPING_COMBINED_TP_MIN_COST_USD=5
V3_DCA_COMBINED_TP=0.20
V3_WINNER_PARTIAL_TP_MAX=0

# --- TSL ---
V3_COMBINED_TSL_ENABLED=false
V3_COMBINED_TSL_STEP=0.035
V3_WINNER_TRAILING_STOP_PCT=0
V3_WINNER_TRAILING_STOP_MIN_COST=25

# --- Rebalance ---
V3_REBALANCE_GAIN_PCT=0.10
V3_REBALANCE_SELL_PCT=0
V3_REBALANCE_PEAK_RESET_PRICE=0.75
V3_REBALANCE_MAX_LOSS_PCT=0.50
V3_REBALANCE_HEDGE_PCT=0.20

# --- Loss Control ---
V3_DCA_LOSS_CUT_PCT=0.70
V3_DCA_LOSS_CUT_SELL_PCT=0.70
V3_SELL_LOSER_MIN_PRICE=0.10
V3_SELL_LOSER_PCT=0.30

# --- Cheap Loser DCA ---
V3_CHEAP_LOSER_DCA_DROP_PCT=0.20
V3_CHEAP_LOSER_DCA_MAX=1
V3_CHEAP_LOSER_DCA_AMOUNT_PCT=0.10

# --- FJ Insurance ---
V3_FJ_TRIGGER_PRICE=0.25
V3_FJ_MAX_LOSS_PCT=0.07
V3_FJ_MIN_WIN_PCT=0.035
V3_FJ_ENFORCE_PRICE=0.70
V3_FJ_LAST_MIN=0.5

# --- Lottery ---
V3_LOTTERY_TICKET_USD=2
V3_LOTTERY_TICKET_PRICE=0.10

# --- Redeem ---
REDEEM_ENABLED=true
REDEEM_INTERVAL_SECS=60
MONGODB_DB=konis_polymarket

# --- Polymarket API ---
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
DATA_HOST=https://data-api.polymarket.com

# --- Blockchain RPC ---
POLYGON_RPC_URL=
POLYGON_WS_URL=

# --- Wallet ---
PRIVATE_KEY=
SIGNATURE_TYPE=1
POLYMARKET_FUNDER=
PROXY_WALLET=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MongoDB (Optional) ---
MONGODB_URL=
