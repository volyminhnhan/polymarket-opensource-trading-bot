# ================================================================
# KoNiS Polymarket Trading Bot v7 — Configuration
# Copy to .env and fill in your values
#
# KoNiS AI (https://konis.ai) — AI-powered prediction engine for
# Polymarket 5-minute binary outcome markets. Multi-pair ML model
# analyzing BTC, ETH, SOL, XRP price action with real-time data
# driven from 7 CEXs (Binance, OKX, Bybit, Gate.io, Phemex,
# CoinEx, BingX) and whale flows. 65-92% prediction accuracy.
# Sign up at konis.ai to get your Prediction API credentials.
# ================================================================

# ================================================================
# General Config
# ================================================================

DRY_RUN=true
BOT_ID=my_bot_1
MAX_RETRY=5

V7_MANAGE_POSITIONS_ONLY=false

TRADING_WINDOW_START_UTC=00:00
TRADING_WINDOW_END_UTC=24:00

# ================================================================
# Market & Timing
# ================================================================

V7_WINDOW_MINUTES=5
V7_ENABLED_MARKETS=btc
SCALPING_CHECK_INTERVAL=2
V7_BG_SYNC_INTERVAL=3
V7_WS_STALE_THRESHOLD=60
V7_SYNC_GRACE_SECONDS=30

# ================================================================
# Entry Config
# ================================================================

BOT_STOP_THRESHOLD=80
V7_ENTRY_MINUTE=0
V7_ENTRY_PRICE=0.52
V7_POSITION_SIZE_USD=5

V7_BUY_BAND_LOW=0.30
V7_BUY_BAND_HIGH=0.80
V7_BUY_MAX_ABOVE_MID=0.01
V7_BUY_MAX_FILL_SLIPPAGE=0.05

V7_FAVOR_PREDICTION=true
V7_MIN_CONFIDENCE=0.70
V7_MIN_QUALITY_SCORE=0
V7_MIN_WEIGHTED_SIGNAL=0
V7_MIN_CROSS_PAIRS_AGREEMENT=2
V7_ENTRY_MIN_MOMENTUM=0
V7_ENTRY_MAX_MINUTE=0
V7_LOCK_PREDICTION_AT_ENTRY_MINUTE=false

# ================================================================
# Exit / TP / SL
# ================================================================

V7_TP_RATIO=0.60
V7_SL_RATIO=0.40
V7_EXIT_PRICE=1.0
TP_PARTIAL_ENABLED=false
V7_TP_SELL_CHUNK_PCT=0
V7_IGNORE_TP_PULLBACK=0

V7_TSL_ENABLED=false
V7_TSL_STEP=0.08

V7_EXIT_BY_PREDICTION=true
V7_MIN_EXIT_CONFIDENCE=0.87

# ================================================================
# Regime Detection
# ================================================================

V7_REGIME_TREND_CONFIDENCE=0.86
V7_REGIME_TREND_MOMENTUM=0.08
V7_REGIME_CHOP_TP=0
V7_REGIME_FLIP_RATE_THRESHOLD=4.0
V7_REGIME_NOISE_THRESHOLD=0.70
V7_REGIME_SPREAD_MULTIPLIER=2.0
V7_REGIME_DEBOUNCE_COUNT=3

# ================================================================
# Modes
# ================================================================

V7_CHEAP_MODE=false
V7_CHEAP_ENTRY_PRICE=0.30
V7_DUAL_MODE_ENABLED=false
V7_DUAL_POSITION_SIZE_USD=0
V7_DUAL_TP_RATIO=0.25
V7_DUAL_SL_RATIO=0

# Hyper entry (early-momentum entry) — DISABLED by default
V7_FOLLOW_MOMENTUM_EARLY=false
V7_FOLLOW_MOMENTUM_EARLY_THRESHOLD=0
V7_FOLLOW_MOMENTUM_EARLY_TP=0
V7_FOLLOW_MOMENTUM_EARLY_MAX_SEC=0
V7_FOLLOW_MOMENTUM_EARLY_MIN_WS=0
V7_FOLLOW_MOMENTUM_EARLY_PRICE_CAP=0

V7_CROSS_MARKET_TRADE=false
V7_CROSS_MARKET_TRADE_WINDOW=5
V7_CROSS_MARKET_ENTRY_MIN=4.0
V7_CROSS_MARKET_ENTRY_MAX=11.0

V7_MAKER_MODE=false
V7_MAKER_CONFIDENCE=0.95
V7_MAKER_MIN_SPREAD=0.03
V7_MAKER_OFFSET=0.01

# ================================================================
# Hedge & Volatility
# ================================================================

V7_HEDGE_ENTRY_PRICE_USD=0
V7_HEDGE_PRICE=0.07

V7_VOLATILITY_HEDGE_ENABLED=false
V7_VOLATILITY_HEDGE_THRESHOLD=btc:0.03,eth:0.1,xrp:0.09,sol:0.1
V7_VOLATILITY_HEDGE_PRICE=0.03
V7_IGNORE_TP_PERC=
V7_PTB_SOURCE=okx

# ================================================================
# Prediction Source (Get from https://konis.ai)
# ================================================================

V7_PREDICTION_SOURCE=http
V7_PREDICTION_WS_URL=
V7_PREDICTION_API_URL=
PREDICTION_USERNAME=
PREDICTION_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379

# ================================================================
# API Endpoints (Polymarket)
# ================================================================

GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
DATA_HOST=https://data-api.polymarket.com

# ================================================================
# Blockchain RPC (Get from Chainstack, Alchemy, Infura, etc.)
# ================================================================

POLYGON_RPC_URL=
POLYGON_WS_URL=

# ================================================================
# Wallet + Signing
#
# SIGNATURE_TYPE:
#   1 = Polymarket wallet (private key exported from Polymarket)
#   2 = MetaMask / EOA wallet (standard private key)
#
# POLYMARKET_FUNDER: Your Polymarket proxy address (shown on Profile Settings)
# PROXY_WALLET: Same as POLYMARKET_FUNDER for type 1
# ================================================================

PRIVATE_KEY=
SIGNATURE_TYPE=1
POLYMARKET_FUNDER=
PROXY_WALLET=

# ================================================================
# Storage (Optional — MongoDB for trade persistence)
# ================================================================

MONGODB_URL=
MONGODB_DB=

# ================================================================
# Redeem Service
# ================================================================

REDEEM_INTERVAL_SECS=60
REDEEM_ENABLED=true
SELL_ENABLED=true
V7_TP_PARTIAL_ENABLED=false
SCALPING_SIMULATED_BALANCE=500

# ================================================================
# Oracle gate — DISABLED by default
# ================================================================
V7_ORACLE_GATE_ENABLED=false
V7_ORACLE_K=200
V7_ORACLE_MIN_DIFF=0.02
V7_ORACLE_EARLY_ENTRY_SEC=0

# ================================================================
# Pace detect — DISABLED by default
# ================================================================
V7_PACE_DETECT=false
V7_PACE_DETECT_PCT=0
V7_PACE_DETECT_WINDOW_SEC=0
V7_PACE_DETECT_PRICE_CAP=0
V7_PACE_DETECT_MAX_SEC=0

V7_PRED_CONFIRM_TICKS=3
V7_TAKER_FEE_PCT=0.02
V7_TP_IGNORE_VWAP=true

# ================================================================
# Hyper prediction / hyper boost — DISABLED by default
# ================================================================
V7_HYPER_PREDICTION=false
V8_WHALE_TREND_SCALPING=false
V7_PAIR_SL_TP=
V7_HYPER_BOOST_ENABLED=false
V7_HYPER_BOOST_MIN_CONF=0
V7_HYPER_BOOST_CONF_RELAX=0
V7_HYPER_BOOST_BAND_EXTEND=0
